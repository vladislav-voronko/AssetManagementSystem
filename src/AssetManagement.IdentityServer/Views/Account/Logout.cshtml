@model LogoutViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign out - Asset Management</title>
</head>
<body>
    <main>
        <h1>Sign out</h1>
        <p>Do you want to sign out of Asset Management?</p>
        <form asp-action="Logout" method="post">
            <input asp-for="LogoutId" type="hidden" />
            <button type="submit">Sign out</button>
        </form>
    </main>
</body>
</html>
