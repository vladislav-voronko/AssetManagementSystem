@model LoginViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in - Asset Management</title>
</head>
<body>
    <main>
        <h1>Sign in</h1>
        <form asp-action="Login" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly"></div>
            <div>
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="username" />
                <span asp-validation-for="Email"></span>
            </div>
            <div>
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </div>
            <div>
                <input asp-for="RememberMe" />
                <label asp-for="RememberMe"></label>
            </div>
            <button type="submit">Sign in</button>
        </form>
        <p>
            Don't have an account?
            <a asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Create one</a>
        </p>
    </main>
</body>
</html>
